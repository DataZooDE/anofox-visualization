# name: test/sql/anofox_plot_contract.test
# description: contract plot macros (anofox_plot_terms/_prediction/_curve/_summary/_obs/_diagnostics/_tests/_compare/_partial/_cv/_decomposition/_events/_checks/_matrix/_assignment/_distribution, anofox_plot, anofox_contract_version) render SVG and reject bad input
# group: [anofox_visualization]

require anofox_visualization

require json

statement ok
LOAD anofox_visualization

# ── terms ────────────────────────────────────────────────────────────────────
statement ok
CREATE TABLE coefs AS SELECT * FROM (VALUES
  ('ols', '(Intercept)', 1.2, 0.8, 1.6), ('ols', 'price', -0.52, -0.71, -0.33),
  ('ridge', '(Intercept)', 1.1, 0.78, 1.42), ('ridge', 'price', -0.41, -0.57, -0.25)
) t(model_id, term, estimate, conf_low, conf_high);

# The whole row is passed: one SVG, a horizontal forest — the estimate runs
# along a continuous x axis (data-xdomain), the terms down the y axis.
query I
SELECT anofox_plot_terms(c) LIKE '<svg%data-xdomain="%' FROM coefs c;
----
true

# One SVG per group.
query I
SELECT count(*) FROM (SELECT anofox_plot_terms(c) AS svg FROM coefs c GROUP BY model_id) WHERE svg LIKE '<svg%';
----
2

# With index_value: an estimate path, one panel per term.
query I
SELECT anofox_plot_terms(p) LIKE '%>price</text>%' FROM (
  SELECT 'lasso' AS model_id, term, 'lambda' AS index_name, lam AS index_value, b * lam AS estimate
  FROM (VALUES ('price', -0.6), ('promo', 0.4)) v(term, b), (SELECT pow(10, -i) AS lam FROM range(5) r(i))) p;
----
true

statement error
SELECT anofox_plot_terms(c) FROM (VALUES ('x1', 0.2)) c(term, weight);
----
needs column(s) estimate

# A producer's own column name is read as the contract one (#54): statsmodels'
# coef is the estimate.
query I
SELECT anofox_plot_terms(c) LIKE '<svg%>x1</text>%' FROM (VALUES ('x1', 0.2)) c(term, coef);
----
true

statement error
SELECT anofox_plot_terms(c) FROM (VALUES ('x1', 'big')) c(term, estimate);
----
must be numeric

# No rows: a "No data" note, not an error.
query I
SELECT anofox_plot_terms(c) LIKE '<svg%No data%' FROM (SELECT * FROM coefs WHERE false) c;
----
true

query I
SELECT anofox_plot(c) LIKE '<svg%No data%' FROM (SELECT * FROM coefs WHERE false) c;
----
true

# ── prediction ───────────────────────────────────────────────────────────────
statement ok
CREATE TABLE pred AS SELECT i AS x, CASE WHEN i < 8 THEN i + 0.5 END AS y, i::DOUBLE AS yhat,
  i - 1.0 AS yhat_lower, i + 1.0 AS yhat_upper, i < 6 AS is_training FROM range(10) r(i);

# No split legend: each split boundary is a dashed vertical line, labelled
# with the split it opens (train|hold-out at 5.5, hold-out|forecast at 7.5).
query I
SELECT anofox_plot_prediction(p) LIKE '<svg%stroke-dasharray="6,3" data-x="5.5"%> hold-out</text>%stroke-dasharray="6,3" data-x="7.5"%> forecast</text>%' FROM pred p;
----
true

# A *_fit_predict_by output: name the x column, panel by the group column.
query I
SELECT anofox_plot_prediction(p, x := 'x1', facet := 'grp') LIKE '%>g1</text>%'
FROM (SELECT x AS x1, y, yhat, yhat_lower, yhat_upper, is_training, 'g' || (x % 2) AS grp FROM pred) p;
----
true

# A ts_forecast_by output (ds, no y).
query I
SELECT anofox_plot_prediction(f) LIKE '<svg%' FROM (
  SELECT 'A' AS id, h AS forecast_step, TIMESTAMP '2024-01-01' + INTERVAL (h) DAY AS ds,
         10.0 + h AS yhat, 8.0 + h AS yhat_lower, 12.0 + h AS yhat_upper, 'AutoETS' AS model_name
  FROM range(1, 8) r(h)) f;
----
true

statement error
SELECT anofox_plot_prediction(p) FROM (VALUES (1, 2.0)) p(t, yhat);
----
needs an x position

statement error
SELECT anofox_plot_prediction(p, facet := 'nope') FROM pred p;
----
facet column `nope` not found

# ── curve ────────────────────────────────────────────────────────────────────
statement ok
CREATE TABLE curves AS
SELECT 'roc' AS curve_type, i / 10.0 AS x, sqrt(i / 10.0) AS y, NULL::DOUBLE AS y_low, NULL::DOUBLE AS y_high FROM range(11) r(i)
UNION ALL SELECT 'acf', i, power(0.5, i), -0.2, 0.2 FROM range(1, 11) r(i)
UNION ALL SELECT 'km', i, exp(-i / 5.0), NULL, NULL FROM range(10) r(i);

query I
SELECT count(*) FROM (SELECT anofox_plot_curve(c) AS svg FROM curves c GROUP BY curve_type) WHERE svg LIKE '<svg%';
----
3

statement error
SELECT anofox_plot_curve(c) FROM curves c;
----
GROUP BY curve_type

statement error
SELECT anofox_plot_curve(c) FROM (VALUES ('spiral', 1.0, 2.0)) c(curve_type, x, y);
----
unknown curve_type 'spiral'

# ── summary ──────────────────────────────────────────────────────────────────
# One panel per metric, headed by the humanised metric name and its range.
query I
SELECT anofox_plot_summary(s) LIKE '<svg%>RMSE  (Δ = 0.1)</text>%>0.81</text>%' FROM (VALUES
  ('ols', 'r2', 0.81), ('ridge', 'r2', 0.79), ('ols', 'rmse', 1.9), ('ridge', 'rmse', 2.0)) s(model_id, metric, value);
----
true

# Bookkeeping metrics only on request.
query II
SELECT svg LIKE '%n observations%', svg2 LIKE '%n observations%' FROM (
  SELECT anofox_plot_summary(s) AS svg, anofox_plot_summary(s, metrics := ['r_squared', 'n_observations']) AS svg2
  FROM (VALUES ('ols', 'r_squared', 0.81), ('ols', 'n_observations', 30)) s(model_id, metric, value));
----
false	true

statement error
SELECT anofox_plot_summary(s, metrics := ['auc']) FROM (VALUES ('ols', 'r_squared', 0.81)) s(model_id, metric, value);
----
matches none of the metrics present

# ── test: comparison forest + significance brackets ──────────────────────────
statement ok
CREATE TABLE tests AS SELECT * FROM (VALUES
  ('b-a', 'a', 'b', 1.2, 0.4, 2.0, 0.003, 'Tukey'), ('c-a', 'a', 'c', 0.3, -0.5, 1.1, 0.41, 'Tukey'),
  ('c-b', 'b', 'c', -0.9, -1.7, -0.1, 0.03, 'Tukey'))
  t(test_id, group1, group2, estimate, conf_low, conf_high, p_adj, method);

query I
SELECT anofox_plot_tests(t) LIKE '<svg%p = 0.003 **%' FROM tests t;
----
true

# anofox_plot dispatches a test table too: the comparison forest.
query I
SELECT anofox_plot(t) LIKE '<svg%>difference (CI)</text>%>b − a</text>%>p = 0.003 **</text>%' FROM tests t;
----
true

statement error
SELECT anofox_plot_tests(t, value := 'nope') FROM tests t;
----
is not one of 'estimate', 'statistic', 'p'

# Several tests' statistics are not one scale (#190): a panel per method,
# titled by the method, the groups on one shared y axis.
statement ok
CREATE TABLE stat2 AS SELECT * FROM (VALUES
  ('A', 'ADF', -0.7, 0.85), ('A', 'KPSS', 2.1, 0.01),
  ('B', 'ADF', -0.2, 0.94), ('B', 'KPSS', 2.0, 0.01)) t(id, method, statistic, p_value);

query III
SELECT (length(svg) - length(replace(svg, 'data-panel="', ''))) // 12,
       svg LIKE '%>ADF</text>%>KPSS</text>%',
       len(list_distinct(regexp_extract_all(svg, 'data-ydomain="([^"]*)"', 1)))
FROM (SELECT anofox_plot_tests(t) AS svg FROM stat2 t);
----
2	true	1

# On −log10(p) every test shares one scale: one panel, rows "A · ADF".
query II
SELECT svg LIKE '%data-panel=%', svg LIKE '%A · ADF%'
FROM (SELECT anofox_plot_tests(t, value := 'p') AS svg FROM stat2 t);
----
false	true

statement ok
CREATE TABLE obs3 AS SELECT CASE i % 3 WHEN 0 THEN 'a' WHEN 1 THEN 'b' ELSE 'c' END AS g,
  (i % 3) * 0.8 + sin(i) AS y FROM range(30) r(i);

# The tests as a LIST subquery … brackets labelled with stars by default,
query I
SELECT anofox_plot_compare(r, value := 'y', factor := 'g', tests := (SELECT list(t) FROM tests t))
  LIKE '<svg%data-x="1 vs 2" data-series="b-a"%>**</text>%>*</text>%>ns</text>%' FROM obs3 r;
----
true

# … or with the p-value (label := 'p').
query I
SELECT anofox_plot_compare(r, value := 'y', factor := 'g', label := 'p', tests := (SELECT list(t) FROM tests t))
  LIKE '<svg%data-series="b-a"%>p = 0.003 **</text>%>p = 0.41</text>%' FROM obs3 r;
----
true

# … or as a literal LIST of STRUCTs; violin; ns hidden.
query II
SELECT svg LIKE '<svg%data-x="1 vs 2"%>**</text>%', svg LIKE '%data-x="1 vs 3"%' FROM (
  SELECT anofox_plot_compare(r, value := 'y', factor := 'g', kind := 'violin', hide_ns := true,
    tests := [{'group1': 'a', 'group2': 'b', 'p_adj': 0.01}, {'group1': 'a', 'group2': 'c', 'p_adj': 0.4}]) AS svg
  FROM obs3 r);
----
true	false

statement error
SELECT anofox_plot_compare(r, value := 'y') FROM obs3 r;
----
needs factor := '<group column>'

# ── partial residuals ────────────────────────────────────────────────────────
statement ok
CREATE TABLE pres AS SELECT CASE WHEN i < 20 THEN 'x1' ELSE 'x2' END AS term, (i % 20)::DOUBLE AS x,
  (i % 20) * 0.5 + sin(i) AS partial_residual, (i % 20) * 0.5 AS component,
  (i % 20) - 9.5 AS x_residual, ((i % 20) - 9.5) * 0.5 + sin(i) AS y_residual FROM range(40) r(i);

# One panel per term: component + residual on y; added-variable panels carry
# the fitted slope in their heading.
query II
SELECT anofox_plot_partial(p) LIKE '<svg%>component + residual</text>%>x1</text>%>component + residual</text>%>x2</text>%',
       anofox_plot_partial(p, kind := 'added_variable') LIKE '<svg%>x1 (slope = %</text>%>x2 (slope = %</text>%' FROM pres p;
----
true	true

query I
SELECT anofox_plot(p) LIKE '<svg%>component + residual</text>%>x2</text>%' FROM pres p;
----
true

# ── common Python / R outputs (#58) ──────────────────────────────────────────
# An interval as one [low, high] LIST (pingouin's CI95%, statsmodels'
# conf_int()): the bounds and the level in the name are read.
query I
SELECT anofox_plot_terms(c) LIKE '%estimate (95% CI)%>x1</text>%' FROM (VALUES ('x1', 0.5, [0.2, 0.8]), ('x2', -0.3, [-0.7, 0.1])) c(term, coef, "CI95%");
----
true

# … or as a STRUCT.
query I
SELECT anofox_plot_terms(c) LIKE '%x2: -0.3 [-0.7, 0.1] · n.s.%' FROM (VALUES ('x1', 0.5, {'lower': 0.2, 'upper': 0.8}), ('x2', -0.3, {'lower': -0.7, 'upper': 0.1})) c(term, estimate, conf_int);
----
true

# conf_level 95 reads as 0.95.
query I
SELECT anofox_plot_terms(c) LIKE '%estimate (95% CI)%' FROM (VALUES ('x1', 0.5, 0.2, 0.8, 95)) c(term, estimate, conf_low, conf_high, conf_level);
----
true

# statsforecast's wide forecast: one line per model, a nested fan per level.
query I
SELECT anofox_plot_prediction(f) LIKE '%AutoARIMA%AutoETS%bands (AutoARIMA): 80 %, 95 % intervals%' FROM (
  SELECT 'A' AS unique_id, DATE '2024-01-01' + h::INTEGER AS ds, 10.0 + h AS "AutoARIMA",
         9.0 + h AS "AutoARIMA-lo-80", 11.0 + h AS "AutoARIMA-hi-80", 8.0 + h AS "AutoARIMA-lo-95", 12.0 + h AS "AutoARIMA-hi-95",
         10.5 + h AS "AutoETS", 8.5 + h AS "AutoETS-lo-95", 12.5 + h AS "AutoETS-hi-95"
  FROM range(1, 8) r(h)) f;
----
true

# MAPE (lower) and F1 (higher) have a direction: the best model is marked.
query I
SELECT anofox_plot_summary(s) LIKE '%>F1  (Δ = 0.1)</text>%>MAPE  (Δ = 0.03)</text>%' FROM (VALUES
  ('a', 'mape', 0.12), ('b', 'mape', 0.09), ('a', 'f1', 0.7), ('b', 'f1', 0.8)) s(model_id, metric, value);
----
true

# A near-perfect AUC keeps three decimals.
query I
SELECT anofox_plot_curve(c) LIKE '%AUC 0.995%' FROM (VALUES ('roc', 0.0, 0.0, 0.9952), ('roc', 0.01, 0.99, 0.9952), ('roc', 1.0, 1.0, 0.9952)) c(curve_type, x, y, auc);
----
true

# ── cv fold timeline (provisional, #189) ──────────────────────────────────────
# One lane per fold_id: train/test windows as bars along an integer period.
query II
SELECT anofox_plot_cv(f) LIKE '<svg%>fold 1</text>%', anofox_plot(f) LIKE '<svg%' FROM (
  SELECT 1 AS fold_id, 'train' AS split, i AS period FROM range(10) r(i)
  UNION ALL SELECT 1, 'test', i FROM range(10, 13) r(i)) f;
----
true	true

# The span form (fold_id, train_start/train_end, test_start/test_end).
query I
SELECT anofox_plot_cv(f) LIKE '<svg%1 fold%' FROM (VALUES
  (1, '2024-01-01'::TIMESTAMP, '2024-02-20'::TIMESTAMP, '2024-02-21'::TIMESTAMP, '2024-02-27'::TIMESTAMP)
) f(fold_id, train_start, train_end, test_start, test_end);
----
true

# ── schedule / Gantt (#176) ───────────────────────────────────────────────────
# One lane per resource (natural order: L2 above L1, #378 review), tasks
# coloured by status; anofox_plot detects it.
query II
SELECT anofox_plot_schedule(s) LIKE '<svg%>L2</text>%>L1</text>%',
       anofox_plot(s) LIKE '<svg%' FROM (VALUES
  ('L1', 'O1', 0, 10, 'on time', 12), ('L1', 'O2', 10, 25, 'late', 20),
  ('L2', 'O3', 0, 15, 'on time', 18)
) s(resource, task, start, "end", status, due);
----
true	true

# A real bar, not an error bar: adjacent tasks on the same resource draw as
# one continuous run of <rect> marks with a <title> tooltip each (not the
# ::SCATTER + ::XMIN/::XMAX "whiskers" look this replaces, #171). The legend
# reads "on time" (a space, not the internal on_time key).
query III
SELECT anofox_plot_schedule(s) LIKE '%<rect%<rect%',
       anofox_plot_schedule(s) LIKE '%<title>O1 · L1: 0 – 10 · on time · due 12</title>%',
       anofox_plot_schedule(s) LIKE '%>on time</text>%' FROM (VALUES
  ('L1', 'O1', 0, 10, 'on time', 12), ('L1', 'O2', 10, 25, 'late', 20)
) s(resource, task, start, "end", status, due);
----
true	true	true

# A due-date connector + end tick (two segment marks) only for the late task
# (O2, end 25 past due 20); the on-time task (O1) keeps due 12 in its
# tooltip alone, no connector of its own — a dot for every task on a shared
# lane can't be matched back to one. Both marks are drawn in ink, not the
# status red a connector over its own red bar would be invisible in.
query III
SELECT anofox_plot_schedule(s) LIKE '%data-geom="segment"%',
       (len(string_split(anofox_plot_schedule(s), 'data-geom="segment"')) - 1) = 2,
       anofox_plot_schedule(s) LIKE '%<title>O2: due 20</title>%' FROM (VALUES
  ('L1', 'O1', 0, 10, 'on time', 12), ('L1', 'O2', 10, 25, 'late', 20)
) s(resource, task, start, "end", status, due);
----
true	true	true

# Both due marks are ink (#0A0A0A), not the status red (#DC2626) a
# connector over its own red bar would be invisible in (#378 review): the
# red only ever appears as the rect's fill, never as a stroke.
query II
SELECT anofox_plot_schedule(s) LIKE '%stroke="#0A0A0A"%',
       NOT anofox_plot_schedule(s) LIKE '%stroke="#DC2626"%' FROM (VALUES
  ('L1', 'O1', 0, 10, 'late', 8)
) s(resource, task, start, "end", status, due);
----
true	true

# A widened bar (start = end) still reports its true, un-widened end in the
# tooltip, not the widened draw width (#378 review).
query I
SELECT anofox_plot_schedule(s) LIKE '%<title>O2 · L1: 20 – 20</title>%' FROM (VALUES
  ('L1', 'O1', 0, 10), ('L1', 'O2', 20, 20)
) s(resource, task, start, "end");
----
true

# Several model_id values facet into one panel each, to compare algorithms;
# "late" is counted across every model, not per panel.
query III
SELECT anofox_plot_schedule(s) LIKE '%>exact</text>%' AND anofox_plot_schedule(s) LIKE '%>today</text>%',
       anofox_plot_schedule(s) LIKE '<svg%late tasks%due dates marked%',
       anofox_plot_schedule(s) LIKE '<svg%1 late across all models%' FROM (VALUES
  ('today', 'L1', 'O1', 0, 10, 12, 'on time'), ('today', 'L1', 'O2', 10, 30, 20, 'late'),
  ('exact', 'L1', 'O1', 0, 10, 12, 'on time'), ('exact', 'L1', 'O2', 10, 18, 20, 'on time')
) s(model_id, resource, task, start, "end", due, status);
----
true	true	true

# A NULL model_id among named ones gets its own "(none)" panel.
query I
SELECT anofox_plot_schedule(s) LIKE '%>(none)</text>%' FROM (VALUES
  ('exact', 'L1', 'O1', 0, 10), (NULL, 'L1', 'O2', 0, 10)
) s(model_id, resource, task, start, "end");
----
true

# No status column: every bar is the synthetic `scheduled` level, no legend.
query I
SELECT anofox_plot_schedule(s) LIKE '<svg%' AND anofox_plot_schedule(s) NOT LIKE '%>late</text>%' FROM (VALUES
  ('L1', 'O1', 0, 10), ('L1', 'O2', 10, 25)
) s(resource, task, start, "end");
----
true

# NULL start/end is dropped, end before start is dropped, start = end is
# widened to a minimum visible bar — each counted in a data-warnings entry.
query I
SELECT anofox_plot_schedule(s) LIKE '%data-warnings%NULL start or end%'
   AND anofox_plot_schedule(s) LIKE '%data-warnings%end before start%'
   AND anofox_plot_schedule(s) LIKE '%data-warnings%widened%' FROM (VALUES
  ('L1', 'O1', 0, 10), ('L1', 'O2', NULL, 20), ('L1', 'O3', 20, 15), ('L1', 'O4', 30, 30)
) s(resource, task, start, "end");
----
true

statement error
SELECT anofox_plot_schedule(s) FROM (VALUES ('L1', 0, 10)) s(resource, start, "end");
----
needs column(s) task

statement error
SELECT anofox_plot_schedule(s) FROM (
  SELECT 'm' || i AS model_id, 'L1' AS resource, 'O1' AS task, 0 AS start, 10 AS "end" FROM range(7) r(i)
) s;
----
GROUP BY model_id

# A numeric start/end with a DATE due is a type mismatch, not epoch seconds.
statement error
SELECT anofox_plot_schedule(s) FROM (VALUES
  ('L1', 'O1', 0, 10, DATE '2024-01-01')
) s(resource, task, start, "end", due);
----
must be the same type

# A TIMESTAMP off midnight: the tooltip shows the time, the axis says "time".
query II
SELECT anofox_plot_schedule(s) LIKE '%06:00%14:30%',
       anofox_plot_schedule(s) LIKE '%>time</text>%' FROM (VALUES
  ('L1', 'O1', TIMESTAMP '2024-01-01 06:00', TIMESTAMP '2024-01-01 14:30')
) s(resource, task, start, "end");
----
true	true

# Plain DATEs (every value at midnight): the axis says "date".
query I
SELECT anofox_plot_schedule(s) LIKE '%>date</text>%' FROM (VALUES
  ('L1', 'O1', DATE '2024-01-01', DATE '2024-01-03')
) s(resource, task, start, "end");
----
true

# ── events and integer periods (#66) ─────────────────────────────────────────
statement ok
CREATE TABLE alarms AS SELECT * FROM (VALUES
  (4, 'stockout', 'on hand 0', 'alarm', 0.0, 5.0, 'SKU-1'),
  (9, 'drift', 'CUSUM', 'warning', 4.2, 4.0, 'SKU-1'),
  (12, 'recalibrated', 'lead time 3 → 4', NULL, NULL, NULL, 'SKU-2')
) t(period, kind, label, severity, value, threshold, series);

statement ok
CREATE TABLE proj AS SELECT p AS period, CASE WHEN p <= 8 THEN 20.0 - p END AS y, 20.0 - p AS yhat,
  20.0 - p - w AS yhat_lower, 20.0 - p + w AS yhat_upper, l AS level
FROM range(1, 17) r(p), (VALUES (80, 2.0), (95, 3.5)) v(l, w);

# An integer period is the x when there is no ds; two levels nest; the events
# are vertical lines coloured by severity, named under the plot.
query I
SELECT anofox_plot_prediction(p, events := (SELECT list(e) FROM alarms e))
  LIKE '<svg%>period</text>%bands: 80 %, 95 % intervals · events: 1 alarm (red), 1 warning (amber), 1 event (grey)%' FROM proj p;
----
true

# The hover text of an event.
query I
SELECT anofox_plot_prediction(p, events := (SELECT list(e) FROM alarms e))
  LIKE '%alarm · stockout · SKU-1: on hand 0 0 (threshold 5)%' FROM proj p;
----
true

statement error
SELECT anofox_plot_prediction(p, events := [{'ds': DATE '2024-01-01', 'kind': 'x'}]) FROM proj p;
----
is a date but the prediction's x (`period`) is not

# On their own: a timeline, one lane per series; anofox_plot detects the schema.
query II
SELECT anofox_plot_events(e) LIKE '<svg%>SKU-2</text>%>SKU-1</text>%', anofox_plot(e) LIKE '<svg%>SKU-1</text>%' FROM alarms e;
----
true	true

statement error
SELECT anofox_plot_events(e) FROM (VALUES ('x', 'alarm')) e(kind, severity);
----
needs an event time

# ── checks (#182) ────────────────────────────────────────────────────────────
statement ok
CREATE TABLE checks3 AS SELECT * FROM (VALUES
  ('rows', 'pass', 120.0, 100.0, NULL),
  ('customer present', 'fail', 0.08, NULL, 0.05),
  ('status known', 'pass', 1.0, 1.0, NULL)
) t(check_name, status, value, lower_threshold, upper_threshold);

# One panel per check, a dot coloured by status against the acceptance band.
query II
SELECT anofox_plot_checks(c) LIKE '<svg%>customer present</text>%', anofox_plot(c) LIKE '<svg%'
FROM checks3 c;
----
true	true

statement ok
CREATE TABLE checks_strip AS SELECT * FROM (VALUES
  ('rows', DATE '2026-10-01', 'pass', 120.0),
  ('rows', DATE '2026-10-02', 'warn', 90.0),
  ('customer present', DATE '2026-10-01', 'pass', 0.01),
  ('customer present', DATE '2026-10-02', 'fail', 0.08)
) t(check_name, ds, status, value);

# Several ds values: a status strip, one lane per check.
query I
SELECT anofox_plot_checks(c) LIKE '<svg%>rows</text>%' FROM checks_strip c;
----
true

statement error
SELECT anofox_plot_checks(c) FROM (VALUES ('a', 'pass')) c(check_name, status);
----
needs column(s) value

# ── decomposition (#188, provisional) ────────────────────────────────────────
statement ok
CREATE TABLE decomp AS SELECT * FROM (VALUES
  (DATE '2024-01-01', 'trend', 1.0), (DATE '2024-01-02', 'trend', 1.2),
  (DATE '2024-01-01', 'seasonal', 0.1), (DATE '2024-01-02', 'seasonal', -0.1),
  (DATE '2024-01-01', 'remainder', 0.02), (DATE '2024-01-02', 'remainder', -0.01)
) t(ds, component, value);

query I
SELECT anofox_plot_decomposition(d) LIKE '<svg%>trend</text>%>remainder</text>%' FROM decomp d;
----
true

query I
SELECT anofox_plot(d) LIKE '<svg%' FROM decomp d;
----
true

# ts_mstl_decomposition_by's list output (seasonal[][] + periods[]): one
# labelled panel per seasonal period.
query I
SELECT anofox_plot(m) LIKE '<svg%seasonal (7)%' FROM (
  SELECT 'B' AS id, [1.0, 2.0, 3.0] AS trend, [[0.1, -0.1, 0.0]] AS seasonal,
         [0.0, 0.1, -0.1] AS remainder, [7] AS periods) m;
----
true

statement error
SELECT anofox_plot_decomposition(d) FROM (VALUES
  ('A', DATE '2024-01-01', 'trend', 1.0), ('B', DATE '2024-01-01', 'trend', 2.0)) d(id, ds, component, value);
----
GROUP BY id

# ── matrix (#183) ────────────────────────────────────────────────────────────
# A pairwise-correlation pair list (anofox_tab_profile_correlations as it
# comes) is mirrored to the full 3x3 matrix with a diagonal of 1.
query II
SELECT anofox_plot_matrix(m) LIKE '<svg%data-kind="heatmap"%', anofox_plot(m) LIKE '<svg%' FROM (VALUES
  ('amount', 'qty', 0.08, 0.09, 120), ('id', 'amount', -0.01, -0.01, 120)
) m(column_a, column_b, pearson, spearman, n);
----
true	true

# value := picks another measure.
query I
SELECT anofox_plot_matrix(m, value := 'spearman') LIKE '<svg%' FROM (VALUES
  ('amount', 'qty', 0.08, 0.09, 120), ('id', 'amount', -0.01, -0.01, 120)
) m(column_a, column_b, pearson, spearman, n);
----
true

# A confusion matrix: row/col already the full grid, no mirroring.
query I
SELECT anofox_plot_matrix(m) LIKE '<svg%' FROM (VALUES
  ('cat', 'cat', 8), ('cat', 'dog', 2), ('dog', 'cat', 1), ('dog', 'dog', 9)
) m(row, col, value);
----
true

statement error
SELECT anofox_plot_matrix(m) FROM (VALUES ('a', 'b', 1), ('a', 'b', 2)) m(row, col, value);
----
one row per cell

# ── assignment (#177) ────────────────────────────────────────────────────────
statement ok
CREATE TABLE bins AS SELECT * FROM (VALUES
  ('first_fit_decreasing', 1, 'c01', 4, 10), ('first_fit_decreasing', 1, 'c02', 5, 10),
  ('first_fit_decreasing', 2, 'c03', 7, 10),
  ('best_of', 1, 'c01', 4, 10), ('best_of', 1, 'c02', 5, 10), ('best_of', 1, 'c03', 1, 10)
) t(model_id, bin, item, size, capacity);

# Items stacked per bin (data-series one per item), the capacity as a quiet
# reference line, several model_id's faceted.
query II
SELECT anofox_plot_assignment(b) LIKE '%data-series="c01"%data-geom="hline"%', anofox_plot(b) LIKE '<svg%'
FROM bins b;
----
true	true

# Pick-wave batching (wave instead of bin), a single model: no facet.
query I
SELECT anofox_plot_assignment(w) LIKE '%data-series="o1"%' FROM (VALUES
  (1, 'o1', 3, 20), (1, 'o2', 4, 20), (2, 'o3', 6, 20)
) w(wave, item, size, capacity);
----
true

statement error
SELECT anofox_plot_assignment(t) FROM (VALUES ('a', 1)) t(item, size);
----
bin

# Bin order follows numeric order, not row order; an integral DOUBLE bin
# ("10.0") shows "10".
query I
SELECT anofox_plot_assignment(b) LIKE '%>0</text>%' AND anofox_plot_assignment(b) NOT LIKE '%>10.0</text>%'
FROM (VALUES (10.0, 'j', 1), (2, 'b', 1), (1, 'a', 1), (0, 'z', 1)) b(bin, item, size);
----
true

# A capacity that varies by bin draws as a marker per bin, not one
# misleading shared reference line.
query I
SELECT anofox_plot_assignment(b) NOT LIKE '%data-geom="hline"%' AND anofox_plot_assignment(b) LIKE '%data-geom="point"%'
FROM (VALUES (1, 'a', 3, 10), (2, 'b', 4, 20)) b(bin, item, size, capacity);
----
true

# A NULL bin is dropped and reported on data-warnings; a NULL item still
# stacks (anofox_plot_assignment alone does not carry data-warnings — only
# the anofox_render/anofox_plot entry point does).
query I
SELECT anofox_render(json_object('plot', 'assignment', 'rows', to_json(list(b ORDER BY b))))
       LIKE '%data-warnings%1 row with a NULL `bin` dropped%'
FROM (VALUES (1, 'a', 3), (NULL, 'b', 4), (1, NULL, 2)) b(bin, item, size);
----
true

# ── distribution (#181) ──────────────────────────────────────────────────────
# One id: a plain bar per option.
query II
SELECT anofox_plot_distribution(d) LIKE '%data-geom="col"%', anofox_plot(d) LIKE '<svg%' FROM (VALUES
  ('q1', 'yes', 0.7), ('q1', 'no', 0.3)
) d(id, option, probability);
----
true	true

# Several ids (decide_table's distribution MAP, unnested with
# unnest(map_entries(distribution))): a 100% stacked bar per id.
query I
SELECT anofox_plot_distribution(d) LIKE '%data-series="yes"%data-series="no"%' FROM (VALUES
  ('q1', 'yes', 0.7), ('q1', 'no', 0.3), ('q2', 'yes', 0.4), ('q2', 'no', 0.6)
) d(id, option, probability);
----
true

statement error
SELECT anofox_plot_distribution(t) FROM (VALUES ('q1', 'yes')) t(id, option);
----
probability

# A NULL id is dropped (it cannot sit on the id axis) and reported; a NULL
# option still stacks.
query I
SELECT anofox_render(json_object('plot', 'distribution', 'rows', to_json(list(d ORDER BY d))))
       LIKE '%data-warnings%1 row with a NULL `id` dropped%'
FROM (VALUES ('q1', 'yes', 0.7), ('q1', NULL, 0.3), (NULL, 'yes', 0.5), ('q2', 'yes', 0.4), ('q2', 'no', 0.6))
     d(id, option, probability);
----
true

# Above 40 ids a data-warning says the axis may be unreadable; the chart
# still draws.
query I
SELECT anofox_render(json_object('plot', 'distribution', 'rows', to_json(list(d ORDER BY d))))
       LIKE '%data-warnings%41 ids plotted%'
FROM (SELECT 'q' || i AS id, 'yes' AS option, 0.5 AS probability FROM range(41) r(i)) d;
----
true

# anofox-decide's own spellings: question_id (its row key before the MAP
# bridge) and model are read as id / model_id.
query I
SELECT anofox_plot_distribution(d) LIKE '%>q1</text>%' AND anofox_plot_distribution(d) LIKE '%>stub</text>%'
       AND anofox_plot_distribution(d) LIKE '%>laya</text>%'
FROM (VALUES
  ('stub', 'q1', 'yes', 0.7), ('stub', 'q1', 'no', 0.3), ('stub', 'q2', 'yes', 0.4), ('stub', 'q2', 'no', 0.6),
  ('laya', 'q1', 'yes', 0.6), ('laya', 'q1', 'no', 0.4), ('laya', 'q2', 'yes', 0.5), ('laya', 'q2', 'no', 0.5))
     d(model, question_id, option, probability);
----
true

# decide_table's distribution MAP, bridged with the documented recipe
# (the unnested STRUCT needs its own alias, u(e), to reach key/value).
statement ok
CREATE TABLE decide_table AS SELECT * FROM (VALUES
  ('stub', 'q1', MAP {'yes': 0.7, 'no': 0.3}),
  ('stub', 'q2', MAP {'yes': 0.4, 'no': 0.6})
) t(model, question_id, distribution);

query I
SELECT anofox_plot_distribution(d) LIKE '<svg%' FROM (
  SELECT t.model, t.question_id AS id, u.e.key AS option, u.e.value AS probability
  FROM decide_table t, unnest(map_entries(t.distribution)) AS u(e)) d;
----
true

# ── contract version ─────────────────────────────────────────────────────────
query I
SELECT anofox_contract_version();
----
1

# ── obs / diagnostics ────────────────────────────────────────────────────────
statement ok
CREATE TABLE aug AS SELECT i AS row_id, 5 + i * 0.2 AS fitted, sin(i * 1.7) AS residual,
  sin(i * 1.7) / 0.7 AS std_residual, 0.02 + i / 400.0 AS leverage, abs(sin(i)) / 20 AS cooks_d, 3 AS n_params
FROM range(40) r(i);

query I
SELECT count(*) FROM (
  SELECT anofox_plot_obs(a, kind := k) AS svg
  FROM aug a, (VALUES ('resid_fitted'), ('qq'), ('scale_location'), ('leverage'), ('cooks')) v(k) GROUP BY k)
WHERE svg LIKE '<svg%';
----
5

statement error
SELECT anofox_plot_obs(a, kind := 'cooks_distance') FROM aug a;
----
kind 'cooks_distance' is not one of

query I
SELECT anofox_plot_diagnostics(a) LIKE '<svg%Residuals vs fitted%Normal Q-Q%Scale-location%Residuals vs leverage%' FROM aug a;
----
true

# ── anofox_plot: dispatch on the column signature ────────────────────────────
query I
SELECT anofox_plot(c) LIKE '<svg%data-xdomain="%' FROM coefs c;
----
true

query I
SELECT anofox_plot(a) LIKE '%Normal Q-Q%' FROM aug a;
----
true

statement error
SELECT anofox_plot(t) FROM (VALUES (1, 2)) t(a, b);
----
anofox contract v1

# Sizes are validated like everywhere else.
statement error
SELECT anofox_plot_terms(c, width := 100000) FROM coefs c;
----
outside [16, 8192]

# scikit-learn metric names have a direction too: average_precision marks
# its best model (one more point than an unknown metric draws).
query I
SELECT (length(a) - length(replace(a, '<circle', ''))) // 7 - (length(b) - length(replace(b, '<circle', ''))) // 7
FROM (SELECT anofox_plot_summary(s) AS a FROM (VALUES ('a', 'average_precision', 0.66),
        ('b', 'average_precision', 0.64)) s(model_id, metric, value)),
     (SELECT anofox_plot_summary(s) AS b FROM (VALUES ('a', 'my_score', 0.66),
        ('b', 'my_score', 0.64)) s(model_id, metric, value));
----
1

# pingouin's pairwise_tests as it comes: BF10 is text holding a number, so
# it does not split the forest into one panel per Bayes factor.
query II
SELECT (length(svg) - length(replace(svg, '<svg', ''))) // 4, svg LIKE '%156.665%' FROM (
  SELECT anofox_plot_tests(r) AS svg FROM (VALUES
    ('g', 0, 10, -3.9, 0.0005, 0.001, 'holm', '156.665'),
    ('g', 0, 20, -7.1, 1e-9, 3e-9, 'holm', '2.648e+09'),
    ('g', 10, 20, -2.2, 0.03, 0.03, 'holm', '1.2'))
  r("Contrast", group1, group2, "T", "p-unc", "p-corr", "p-adjust", "BF10"));
----
1	false

# Opaque points carry no fill-opacity (the SVG default), hover data stays.
query II
SELECT svg NOT SIMILAR TO '.*<circle [^>]*fill-opacity="1.000".*', svg LIKE '%<circle %data-value=%<title>%'
FROM (SELECT anofox_plot_diagnostics(o) AS svg FROM (
  SELECT i AS row_id, i::DOUBLE AS fitted, sin(i) AS residual FROM range(30) r(i)) o);
----
true	true

# ── anofox_plot: no "closest" hint from a generic column (#180) ──────────────
statement error
SELECT anofox_plot(t) FROM (SELECT 'q1' AS question_id, 'binary' AS kind, 0.7 AS probability) t;
----
match no plottable schema

statement error
SELECT anofox_plot(t) FROM (SELECT 'q1' AS question_id, 'binary' AS kind, 0.7 AS probability) t;
----
<!REGEX>:.*closest.*

# The schema's identifying column still earns the hint (period stands in for ds).
statement error
SELECT anofox_plot(t) FROM (SELECT 3 AS period, 'x' AS note) t;
----
closest: events, missing kind

# A short identifying name one letter off (team ~ term) gives no hint (#255).
statement error
SELECT anofox_plot(t) FROM (SELECT 'x' AS team, 'binary' AS kind, 0.7 AS probability) t;
----
<!REGEX>:.*closest.*
