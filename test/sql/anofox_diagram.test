# name: test/sql/anofox_diagram.test
# description: anofox_render draws a ::DIAGRAM (node/edge diagram) from one row per node
# group: [anofox_visualization]

require anofox_visualization

# json_object (the anofox_render options) lives in the json extension.
require json

statement ok
LOAD anofox_visualization

statement ok
CREATE TABLE stages AS SELECT * FROM (VALUES
  (1, 'ingest', 'Ingest', 10000, []::VARCHAR[]),
  (2, 'build', 'Build twin', 9800, ['ingest', 'calibrate']),
  (3, 'monitor', 'Monitor drift', 412, ['build']),
  (4, 'calibrate', 'Calibrate', 37, ['monitor'])
) t(seq, stage, title, n, inputs);

# Nodes from the rows, edges from each row's ::UPSTREAM list; a loop is drawn
# back and named in the screen-reader summary.
query I
SELECT anofox_render(json_object(
  'rows', (SELECT to_json(list({c0: stage, c1: title, c2: n, c3: inputs} ORDER BY seq)) FROM stages),
  'roles', json('[[0,"DIAGRAM"],[1,"LABEL"],[2,"COMPACT"],[3,"UPSTREAM"]]'),
  'width', 800, 'height', 300)) LIKE '<svg%data-summary="4 steps in 4 stages, from Ingest; 4 connections; 1 loop (Calibrate → Build twin); largest Ingest (10K)"%data-diagram="LR"%data-node="build"%';
----
true

# Edges with attributes from a list of structs (::EDGES), top to bottom.
# Order-agnostic: the edge is drawn by ggplot-rs (#421), whose class list carries
# more tokens (gg-mark gg-path dp-flow flow-speed-N) and whose attribute order differs.
query I
SELECT svg LIKE '<svg%data-diagram="TB"%'
   AND regexp_matches(svg, '<polyline[^>]*class="[^"]*\bdp-flow\b[^"]*"[^>]*data-edge="ingest&gt;build"|<polyline[^>]*data-edge="ingest&gt;build"[^>]*class="[^"]*\bdp-flow\b[^"]*"')
FROM (SELECT anofox_render(json_object(
  'rows', (SELECT to_json(list({c0: stage, c1: e, c2: 'TB'} ORDER BY seq)) FROM stages,
           (SELECT list({'from': 'ingest', 'to': 'build', 'value': 9800, 'style': 'flow'}) AS e)),
  'roles', json('[[0,"NODE"],[1,"EDGES"],[2,"DIRECTION"]]'),
  'width', 400, 'height', 400)) AS svg);
----
true

# Motion: a ::STORY caption per node becomes a step keyed by its id, a row's
# ::LINESTYLE styles the edges into it ('flow-dots': travelling dots).
query I
SELECT anofox_render(json_object(
  'rows', (SELECT to_json(list({c0: stage, c1: inputs,
                                c2: CASE stage WHEN 'monitor' THEN 'Twins drift' END,
                                c3: CASE stage WHEN 'build' THEN 'flow-dots' END} ORDER BY seq)) FROM stages),
  'roles', json('[[0,"DIAGRAM"],[1,"UPSTREAM"],[2,"STORY"],[3,"LINESTYLE"]]'),
  'width', 800, 'height', 300)) LIKE '<svg%data-story="[{&quot;k&quot;:&quot;monitor&quot;,&quot;t&quot;:&quot;Twins drift&quot;}]"%class="dp-flow dp-dots" data-edge="ingest&gt;build"%';
----
true

# The `graph` contract: anofox_plot_diagram reads a node table and a LIST of
# edges — Grafana's node-graph names, or inventory-rs's run manifest as
# written (stage / from_stage / to_stage / count), ordered by seq.
statement ok
CREATE TABLE run_manifest AS SELECT * FROM (VALUES
  ('demo-42', 'stream', 4, 1440, 28),
  ('demo-42', 'ingest', 1, 9133, 0),
  ('demo-42', 'build_twin', 2, 12, 0),
  ('demo-42', 'calibrate', 3, 1440, 0)
) t(run_id, stage, seq, records_in, alarms);

statement ok
CREATE TABLE run_edges AS SELECT * FROM (VALUES
  ('ingest', 'build_twin', 9128), ('build_twin', 'calibrate', 12), ('build_twin', 'stream', 12),
  ('stream', 'calibrate', 3), ('calibrate', 'stream', 78)
) t(from_stage, to_stage, count);

query I
SELECT anofox_plot_diagram(m, edges := (SELECT list(e) FROM run_edges e), mainstat := 'records_in')
  LIKE '<svg%data-summary="4 steps in % stages, from ingest%; 5 connections; 1 loop (%'
FROM run_manifest m;
----
true

query I
SELECT anofox_plot_diagram(n, edges := [{'source': 'a', 'target': 'b', 'value': 3, 'status': 'delayed', 'style': 'flow-volume'}],
                           direction := 'TB')
  LIKE '<svg%data-diagram="TB"%data-node="a"%'
FROM (VALUES ('a', 'Load', 10, 'Ops'), ('b', 'Clean', 8, 'Data')) n(id, title, mainstat, lane);
----
true

# Swimlanes and the edge's health / speed reach the SVG.
query I
SELECT anofox_plot_diagram(n, edges := [{'source': 'a', 'target': 'b', 'value': 3, 'status': 'delayed', 'style': 'flow-volume'}])
  LIKE '%data-lane="Ops"%animation-duration:0.6s%data-status="warn"%'
FROM (VALUES ('a', 'Load', 10, 'Ops'), ('b', 'Clean', 8, 'Data')) n(id, title, mainstat, lane);
----
true

statement error
SELECT anofox_plot_diagram(n) FROM (VALUES (1, 2)) n(what, ever);
----
an id column
